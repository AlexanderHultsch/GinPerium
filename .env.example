# Kopiere nach .env und trage echte Werte ein. .env ist gitignored — NIEMALS committen!
# Auf dem Pi liegt die .env nur dort (z.B. apps/ginperium/.env) und wird per
# env_file in den Container gereicht.

# Port, auf dem die App lauscht
PORT=3000

# Pfad der SQLite-Datei. Eigene, von anderen Projekten vollständig getrennte
# Datenbank. Im Container: /data/ginperium.db (eigenes benanntes Docker-Volume).
DB_PATH=./data/ginperium.db

# Session-Secret für Login-Cookies (Pflicht in Produktion!).
# Erzeugen z. B. mit:  openssl rand -base64 32
SESSION_SECRET=<<LANGES_ZUFAELLIGES_SECRET>>

# Einmaliger Admin-Seed (npm run seed:admin liest diese Werte)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<<SICHERES_PASSWORT>>

# Optional: Cookie-Secure-Flag erzwingen — nur einschalten, wenn die App
# selbst direkt über HTTPS ausgeliefert wird (hinter einem Reverse Proxy: aus lassen).
# SECURE_COOKIES=true

# Optional: Anzahl vertrauenswürdiger Reverse-Proxy-Hops (Default 1).
# TRUST_PROXY=1
